# Copia este archivo como «.env» en el servidor y completa los valores.
# «.env» NUNCA se sube a GitHub: contiene las claves del sitio.

# Activa el modo producción: sin datos de ejemplo y sin claves de prueba.
JUNTA_ENTORNO=produccion

# Clave interna para firmar las sesiones (60+ caracteres al azar). Para generarla:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Cuenta de administración que se crea la primera vez que arranca el sitio.
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Cuenta de coordinación (opcional: bórrala si no se usará al inicio).
# COORD_USER=coordinador
# COORD_PASSWORD=
# COORD_EMAIL=

# Carpeta de datos (base de datos, documentos privados y respaldos).
# En PythonAnywhere: /home/TU_USUARIO/datos-junta
DATA_DIR=

# Correo saliente (ejemplo con Gmail y una «contraseña de aplicación»).
# Sin estas variables el sitio funciona, pero no envía avisos ni recuperación de clave.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
